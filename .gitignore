# ------------------------------------------------------------------------------
# Terraform
# ------------------------------------------------------------------------------
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ------------------------------------------------------------------------------
# Ansible
# ------------------------------------------------------------------------------
*.retry
*.log
.ansible/
# Ignore roles that might be downloaded from ansible-galaxy locally
# roles/  (Uncomment if you don't commit downloaded roles)

# ------------------------------------------------------------------------------
# Bash Scripts / Temporary Files
# ------------------------------------------------------------------------------
# Temporary output files or script buffers
*.tmp
*.temp
*.swp
*~

# ------------------------------------------------------------------------------
# OS Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# Secrets & Environments
# ------------------------------------------------------------------------------
# Ignore local environment variables and secrets
.env
*.pem
*.key
*.cert
*.crt
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
